# env.example — список переменных окружения для Amvera Cloud.
# Скопируй этот файл и вставь значения в Amvera UI: раздел «Переменные» сервиса.
# Никогда не коммить реальный .env в репо — этот файл без секретов (плейсхолдеры).

# Обязательные
APP_CONFIG=prod
SECRET_KEY=<вставь свой SECRET_KEY из Hostim>
DATABASE_URI=postgresql+psycopg2://postgres:<пароль>@<хост-amvera-db>:5432/postgres
MAIN_ADMIN_PASSWORD_HASH=<вставь свой MAIN_ADMIN_PASSWORD_HASH>
SESSION_COOKIE_SECURE=True
GUNICORN_WORKERS=2

# Не задавать (специфично для Hostim и опасно для прода):
#   PURGE_SELLER_SUBS_ON_BOOT
#   PURGE_SELLER_ID
#   RESET_DB
#   GRANT_TEST_TARIFF_SELLER_ID
